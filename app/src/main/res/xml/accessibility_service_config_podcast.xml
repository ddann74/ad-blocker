<?xml version="1.0" encoding="utf-8"?>
<!-- Only used to tell when Podcast Addict is the foreground app (to show/hide the
     floating Skip button) - the actual skip itself goes through PodcastMediaListenerService's
     MediaSession control, not this service's window content, so canRetrieveWindowContent
     is left off here. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="false"
    android:notificationTimeout="100"
    android:description="@string/podcast_accessibility_service_description" />
